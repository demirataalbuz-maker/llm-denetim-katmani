# Hedef LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=120
# İstemcinin `model` alanıyla seçebileceği modeller (virgülle). Boşsa yalnızca
# OLLAMA_MODEL kullanılabilir.
IZINLI_MODELLER=

# Sunucu
DENETIM_HOST=127.0.0.1
DENETIM_PORT=8000

# Erişim denetimi. Boş bırakılırsa kapalıdır; proxy'yi 127.0.0.1 dışında
# dinletiyorsanız MUTLAKA doldurun.
# /chat ve /kurallar: "X-API-Key: <anahtar>" veya "Authorization: Bearer <anahtar>"
DENETIM_API_ANAHTARI=
# /panel: HTTP Basic (kullanıcı adı serbest, parola bu değer)
PANEL_SIFRESI=

# Giriş denetimi eşikleri (0.0 - 1.0)
GIRIS_ENGEL_ESIGI=0.75
GIRIS_UYARI_ESIGI=0.40
# Engellenen istekte dönülecek HTTP kodu (403 veya 200)
ENGEL_HTTP_KODU=403

# Model tabanlı filtre (varsayılan kapalı; transformers + torch gerektirir)
MODEL_FILTRESI_ACIK=false
HF_MODEL_ADI=protectai/deberta-v3-base-prompt-injection-v2
HF_MODEL_ESIGI=0.80
# Model filtresi açıkken model yüklenemez/çökerse isteği engelle (fail-closed)
MODEL_FILTRESI_KATI=true
# İstemci `sistem` alanı gönderebilsin mi? Gönderilirse o alan da giriş
# denetiminden geçer. false ise `sistem` içeren istekler 400 ile reddedilir.
ISTEMCI_SISTEM_MESAJI=true

# Çıkış denetimi
CIKIS_TARAMA_ACIK=true
# Girişi de maskele (KVKK: kişisel veriyi modele hiç göndermemek için)
GIRIS_MASKELEME_ACIK=false
# Adres ipucu gibi düşük güvenli kalıpları da aç
DUSUK_GUVEN_KALIPLARI=false

# Loglama
DB_YOLU=logs/denetim.db
ONIZLEME_UZUNLUGU=240
